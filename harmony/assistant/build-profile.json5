{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS",
        "targetSdkVersion": "6.1.1(24)",
        "buildOption": {
          "strictMode": {
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "health",
      "srcPath": "../health"
    },
    {
      "name": "coffee",
      "srcPath": "../coffee"
    },
    {
      "name": "agent_viewer",
      "srcPath": "../agent-viewer"
    },
    {
      "name": "org_renderer",
      "srcPath": "../org-renderer"
    }
  ]
}
