;;; loki-assistant-slack-chat-tests.el --- Slack 内嵌线程测试 -*- lexical-binding: t; -*-

(require 'ert)
(require 'loki-assistant-slack-chat)

(ert-deftest loki-assistant-slack-chat-test-renders-message-content ()
  (skip-unless (require 'agent-shell-markdown nil t))
  (let ((profiles (make-hash-table :test #'equal))
        (images (make-hash-table :test #'equal))
        (image '(image :type png))
        (avatar '(image :type png :width 20))
        (room '((id . "TTEST.CCHAT") (team_id . "TTEST") (session_id . "local")))
        (message '((ts . "104.0") (author . ((id . "TTEST.U1") (name . "U1")))
                   (text . "请看 <https://example.com/report|版本报告|新版>，<@U1>。\n<!here> 和 &lt;占位&gt;\n:wave: <slack://preferences?section=shortcuts|首选项>\n[本机文件](file:///tmp/private)")
                   (tables . [[ ["版本" "成功率"] ["3.3.107" "99.5%"] ]])
                   (attachments . [((title . "报告截图.png") (size . 4096) (image . t)
                                    (url . "https://workspace.slack.com/files/F1"))]))))
    (puthash "TTEST.U1" '((name . "林舟") (avatar_path . "/fixture/avatar.png")) profiles)
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
              ((symbol-function 'loki-assistant-slack--file-image)
               (lambda (path _width _height)
                 (when (equal path "/fixture/avatar.png") avatar)))
              ((symbol-function 'loki-assistant-slack--media)
               (lambda (path params room _images _refresh width height)
                 (should (equal path "/slack/conversations/TTEST.CCHAT/messages/104.0/attachments/0/preview"))
                 (should (equal params '((local_path . "true"))))
                 (should (equal (alist-get 'session_id room) "local"))
                 (should (equal (list width height) '(560 320)))
                 image)))
      (with-temp-buffer
        (loki-assistant-slack--message message room profiles images #'ignore)
        (goto-char (point-min))
        (should (equal (button-label (button-at (point))) " ○ 林舟 "))
        (forward-char)
        (should (eq (get-text-property (point) 'display) avatar))
        (should (eq (get-text-property (point) 'face) 'loki-assistant-slack-sender-label))
        (should (text-property-any (point-min) (point-max) 'display image))
        (should (text-property-not-all (point-min) (point-max) 'agent-shell-markdown-table-source nil))
        (goto-char (point-min))
        (search-forward "版本报告|新版")
        (should (button-at (1- (point))))
        (search-forward "@林舟")
        (search-forward "<!here> 和 <占位>")
        (search-forward "👋 首选项")
        (should (equal (button-get (button-at (1- (point))) 'help-echo)
                       "slack://preferences?section=shortcuts"))
        (search-forward "本机文件")
        (should-not (button-at (1- (point))))
        (search-forward "报告截图.png")
        (should (button-at (1- (point))))))))

(ert-deftest loki-assistant-slack-chat-test-reads-local-message-cache ()
  (let* ((path (make-temp-file "loki-slack-message-"))
         (entry `((ts . "10.000001") (text . "HTTP 正文") (cache_path . ,path))))
    (unwind-protect
        (progn
          (with-temp-file path
            (insert "((ts . \"10.000001\") (text . \"缓存正文\") (edited . :false))\n"))
          (should (equal (alist-get 'text (loki-assistant-slack--cached-record entry 'ts "10.000001" '(text)))
                         "缓存正文"))
          (with-temp-file path (insert "((ts . \"10.000001\")"))
          (should (equal (loki-assistant-slack--cached-record entry 'ts "10.000001" '(text)) entry))
          (delete-file path)
          (should (equal (loki-assistant-slack--cached-record entry 'ts "10.000001" '(text)) entry)))
      (when (file-exists-p path) (delete-file path)))))

(ert-deftest loki-assistant-slack-chat-test-inline-thread-and-reply ()
  (skip-unless (require 'shell-maker nil t))
  (let ((shell-maker-root-path (make-temp-file "loki-slack-chat-test-" t))
        (shell-maker-prompt-before-killing-buffer nil)
        (room '((id . "TTEST.DCHAT") (session_id . "session") (team_id . "TTEST") (title . "聊天")))
        (root-path "/slack/conversations/TTEST.DCHAT/messages")
        (thread-path "/slack/conversations/TTEST.DCHAT/threads/123.000001/messages")
        buffer sent)
    (unwind-protect
        (save-window-excursion
          (cl-letf (((symbol-function 'loki-assistant-slack--request)
                     (lambda (method path callback &rest args)
                       (cond
                        ((equal method "POST")
                         (setq sent (cons path (plist-get args :body)))
                         (funcall callback '(:ok t :data ((state . "sent")))))
                        ((equal path "/status/slack/connections")
                         (funcall callback '(:ok t :data ((value . [((session_id . "session")
                                                                    (user_id . "TTEST.U1"))])))))
                        ((equal path "/slack/users")
                         (funcall callback '(:ok t :data ((items . [])))))
                        ((equal path thread-path)
                         (funcall callback
                                  '(:ok t :data ((items . [((ts . "124.000001") (text . "既有回复"))])))))
                        ((equal path root-path)
                         (funcall callback
                                  '(:ok t :data ((items . [((ts . "123.000001") (text . "根消息")
                                                            (reply_count . 1))
                                                           ((ts . "172923.000001") (text . "隔日消息")
                                                            (author . ((id . "TTEST.U1") (name . "本人"))))])))))
                        (t (ert-fail path))))))
            (setq buffer (loki-assistant-slack--open room))
            (with-current-buffer buffer
              (should (= 2 (how-many "^────────  [0-9-]+  ────────$" (point-min) (point-max))))
              (should (= 1 (how-many "[▸▾]" (point-min) (point-max))))
              (should (string-match-p "既有回复" (buffer-string)))
              (goto-char (loki-assistant-slack--message-position "172923.000001"))
              (should (equal (button-label (button-at (point))) " ○ 我 "))
              (should (eq (get-text-property (point) 'face) 'loki-assistant-slack-self-label))
              (goto-char (loki-assistant-slack--message-position "123.000001"))
              (execute-kbd-macro (kbd "n"))
              (should (equal "▾ 1 条回复" (button-label (button-at (point)))))
              (loki-assistant-slack--render)
              (should (equal "▾ 1 条回复" (button-label (button-at (point)))))
              (should (eq (key-binding (kbd "<backtab>")) #'loki-assistant-slack-previous-item))
              (execute-kbd-macro (kbd "<backtab>"))
              (should (= (point) (loki-assistant-slack--message-position "123.000001")))
              (goto-char (point-min))
              (should-error (insert "历史") :type 'text-read-only)
              (goto-char loki-assistant-slack--history-end)
              (should-error (insert "提示符") :type 'text-read-only)
              (goto-char (1- loki-assistant-slack--history-end))
              (execute-kbd-macro (kbd "TAB"))
              (should (= (point) (loki-assistant-slack--draft-start)))
              (execute-kbd-macro (kbd "p n"))
              (should (equal (buffer-substring-no-properties (loki-assistant-slack--draft-start) (point-max)) "pn"))
              (setq loki-assistant-slack--history-end nil)
              (should (eq (loki-assistant-slack--open room) buffer))
              (should (eq (loki-assistant-slack--open room) buffer))
              (should (= 1 (how-many "根消息" (point-min) (point-max))))
              (should (= 1 (how-many "既有回复" (point-min) (point-max))))
              (should (equal (buffer-substring-no-properties (loki-assistant-slack--draft-start) (point-max)) "pn"))
              (delete-region (loki-assistant-slack--draft-start) (point-max))
              (loki-assistant-slack--toggle "123.000001")
              (should (string-match-p "▸ 1 条回复" (buffer-string)))
              (should-not (string-match-p "既有回复" (buffer-string)))
              (loki-assistant-slack-refresh)
              (should-not (string-match-p "既有回复" (buffer-string)))
              (loki-assistant-slack--toggle "123.000001")
              (should (string-match-p "根消息\\(?:.\\|\n\\)*既有回复" (buffer-string)))
              (goto-char (point-max))
              (insert "主会话草稿")
              (loki-assistant-slack--toggle "123.000001")
              (should-not (string-match-p "既有回复" (buffer-string)))
              (should (equal (buffer-substring-no-properties (loki-assistant-slack--draft-start) (point-max))
                             "主会话草稿"))
              (delete-region (loki-assistant-slack--draft-start) (point-max))
              (goto-char (loki-assistant-slack--message-position "123.000001"))
              (cl-letf (((symbol-function 'read-multiple-choice) (lambda (&rest _) '(?r "回复"))))
                (push-button))
              (should (equal (get-text-property loki-assistant-slack--history-end 'display)
                             "线程回复> "))
              (should (eq (current-buffer) buffer))
              (insert "线程新回复")
              (call-interactively (key-binding (kbd "RET")))
              (should (equal sent (list thread-path (cons 'text "线程新回复"))))
              (should (= (loki-assistant-slack--draft-start) (point-max)))
              (loki-assistant-slack--main-target)
              (should-not (get-text-property loki-assistant-slack--history-end 'display))
              (should (eq (window-buffer (selected-window)) buffer)))))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (set-buffer-modified-p nil))
        (kill-buffer buffer))
      (delete-directory shell-maker-root-path t))))

(ert-deftest loki-assistant-slack-chat-test-consult-reuses-conversation-window ()
  (skip-unless (and (require 'consult nil t) (require 'shell-maker nil t)))
  (let* ((shell-maker-root-path (make-temp-file "loki-slack-chat-test-" t))
         (shell-maker-prompt-before-killing-buffer nil)
         (loki-assistant-slack--selection (list nil))
         (first '((id . "TTEST.DONE") (session_id . "session") (title . "会话一")))
         (second '((id . "TTEST.DTWO") (session_id . "session") (title . "会话二")))
         windows)
    (unwind-protect
        (save-window-excursion
          (when-let ((window (minibuffer-selected-window)))
            (select-window window))
          (cl-letf (((symbol-function 'active-minibuffer-window) #'ignore)
                    ((symbol-function 'loki-assistant-slack--request)
                     (lambda (&rest _) nil)))
            (dolist (room (list first second first))
              (cl-letf (((symbol-function 'consult--read)
                         (lambda (choices &rest _)
                           (should (= (length (funcall choices nil)) 2))
                           room)))
                (loki-assistant-slack--choose (selected-window)
                                              loki-assistant-slack--selection (list first second))
                (push (selected-window) windows)))
            (should (eq (nth 0 windows) (nth 2 windows)))
            (should-not (eq (nth 0 windows) (nth 1 windows)))))
      (dolist (name '("*Slack TTEST.DONE*" "*Slack TTEST.DTWO*"))
        (when-let ((buffer (get-buffer name))) (kill-buffer buffer)))
      (delete-directory shell-maker-root-path t))))

(ert-deftest loki-assistant-slack-chat-test-picker-groups-and-matches-pinyin ()
  (skip-unless (require 'consult nil t))
  (let* ((loki-assistant-slack--selection (list nil))
         (mention '((id . "TA.C1") (team_id . "TA") (team_name . "核心组")
                    (title . "产品讨论") (kind . "public_channel")
                    (search_terms . ["产品讨论"])
                    (last_activity_ts . "200.0") (last_unread_mention_ts . "190.0") (unread_count . 2)))
         (direct '((id . "TB.D1") (team_id . "TB") (team_name . "设计组")
                   (title . "張偉") (kind . "im")
                   (search_terms . ["張偉" "designer" "zhangwei" "zw"])
                   (participants . [((id . "TB.U1") (name . "張偉") (avatar_url . :null))])
                   (last_activity_ts . "400.0") (unread_count . 1)
                   (last_message . ((author_name . "張偉") (ts . "400.0") (preview . "设计稿")))))
         (read '((id . "TA.C2") (team_id . "TA") (title . "周会") (kind . "private_channel")
                 (last_activity_ts . "500.0")))
         opened)
    (cl-letf (((symbol-function 'active-minibuffer-window) #'ignore)
              ((symbol-function 'loki-assistant-slack--open) (lambda (room) (setq opened room)))
              ((symbol-function 'completing-read)
               (lambda (_prompt table &rest _)
                 (let* ((metadata (completion-metadata "" table nil))
                        (groups (completion-metadata-get metadata 'group-function))
                        (affix (completion-metadata-get metadata 'affixation-function))
                        (all (all-completions "" table)))
                   (should (equal (mapcar (lambda (s) (funcall groups s nil)) all)
                                  '("未读 @我" "其他未读" "其余聊天")))
                   (dolist (query '("ZW" "zhang" "zhangwei" "designer" "張偉"))
                     (let ((matches (completion-all-completions query table nil (length query) metadata)))
                       (should (equal matches (cons (nth 1 all) 0)))))
                   (should (equal (completion-all-completions "产论" table nil 2 metadata) (cons (car all) 0)))
                   (should-not (completion-all-completions "无此聊天" table nil 4 metadata))
                   (let* ((rows (funcall affix all))
                          (direct-row (nth 1 rows))
                          (columns (lambda (row part)
                                     (let ((text (nth part row)))
                                       (cl-loop for i below (length text)
                                                for display = (get-text-property i 'display text)
                                                when (eq (car-safe display) 'space)
                                                collect (plist-get (cdr display) :align-to))))))
                     (should (string-match-p "私聊.*○" (nth 1 direct-row)))
                     (should (string-match-p "设计组.*1 未读.*張偉.*设计稿" (nth 2 direct-row)))
                     (dolist (row rows)
                       (should (equal (funcall columns row 1) '(10 19)))
                       (should (= (length (funcall columns row 2)) 3))
                       (should (equal (funcall columns row 2) (funcall columns direct-row 2)))))
                   (nth 1 all)))))
      (loki-assistant-slack--choose (selected-window) loki-assistant-slack--selection (list read direct mention))
      (should (equal opened direct)))))

(ert-deftest loki-assistant-slack-chat-test-picker-requests-one-fresh-snapshot ()
  (skip-unless (and (require 'consult nil t) (require 'shell-maker nil t)))
  (let (requests choices)
    (cl-letf (((symbol-function 'loki-assistant-slack--request)
               (lambda (method path callback &rest _)
                 (push (cons method path) requests)
                 (funcall callback `(:ok t :data ((items . [((id . ,(length requests)))]))))))
              ((symbol-function 'run-at-time)
               (lambda (_time _repeat callback &rest args) (apply callback args)))
              ((symbol-function 'loki-assistant-slack--choose)
               (lambda (_window _selection rooms _status) (push (alist-get 'id (car rooms)) choices))))
      (loki-assistant-slack-select-chat)
      (loki-assistant-slack-select-chat)
      (should (equal requests '(("GET" . "/slack/conversations/picker")
                                ("GET" . "/slack/conversations/picker"))))
      (should (equal choices '(2 1))))))

(ert-deftest loki-assistant-slack-chat-test-opens-notification-at-thread-reply ()
  (skip-unless (and (display-graphic-p) (require 'shell-maker nil t)))
  (let* ((shell-maker-root-path (make-temp-file "loki-slack-notification-test-" t))
         (shell-maker-prompt-before-killing-buffer nil)
         (payload (json-serialize
                   '((room . ((id . "TTEST.DNOTIFY") (title . "通知测试") (session_id . "one")))
                     (root . ((ts . "101.0") (text . "根消息") (reply_count . 1)))
                     (reply . ((ts . "102.0") (text . "定位回复")))
                     (thread_ts . "101.0") (message_ts . "102.0")))))
    (unwind-protect
        (save-window-excursion
          (cl-letf (((symbol-function 'loki-assistant-slack--request) #'ignore))
            (should (eq (loki-assistant-slack-open-notification payload) 'message))
            (with-current-buffer "*Slack TTEST.DNOTIFY*"
              (should (equal (get-text-property (point) 'loki-slack-message) "102.0"))
              (loki-assistant-slack--render)
              (should (equal (get-text-property (point) 'loki-slack-message) "102.0")))))
      (when-let ((buffer (get-buffer "*Slack TTEST.DNOTIFY*"))) (kill-buffer buffer))
      (delete-directory shell-maker-root-path t))))

(provide 'loki-assistant-slack-chat-tests)
