;;; loki-assistant-slack-chat-tests.el --- Slack 聊天界面测试 -*- lexical-binding: t; -*-

(require 'ert)
(require 'loki-assistant-slack-chat)
(require 'loki-assistant-dispatch)

(ert-deftest loki-assistant-slack-chat-test-watch-updates-title-after-confirmation ()
  (with-temp-buffer
    (setq-local loki-assistant-slack--room
                '((id . "TTEST.CCHAT") (kind . "private_channel") (title . "产品讨论")))
    (let (requests
          (key (kbd "C-c C-w")))
      (insert "草稿")
      (goto-char (point-min))
      (loki-assistant-slack-input-mode 1)
      (should (eq (key-binding key) #'loki-assistant-slack-toggle-watch))
      (cl-letf (((symbol-function 'loki-assistant-slack--request)
                 (lambda (method path callback &rest args)
                   (should (equal path "/slack/conversations/TTEST.CCHAT/watch"))
                   (push (list method (alist-get 'watching (plist-get args :body)) callback)
                         requests))))
        (loki-assistant-slack--request-watch)
        (should (equal (caar requests) "GET"))
        (funcall (nth 2 (car requests))
                 '(:ok t :data ((conversation_id . "TTEST.CCHAT") (watching . :false))))
        (should (string-suffix-p "〔未关注〕" header-line-format))
        (call-interactively (key-binding key))
        (call-interactively (key-binding key))
        (should (= (length requests) 2))
        (should (equal (seq-take (car requests) 2) '("PUT" t)))
        (should (string-suffix-p "〔未关注〕" header-line-format))
        (funcall (nth 2 (car requests))
                 '(:ok t :data ((conversation_id . "TTEST.CCHAT") (watching . t))))
        (should (string-suffix-p "〔已关注〕" header-line-format))
        (loki-assistant-slack-unwatch)
        (should (equal (seq-take (car requests) 2) '("PUT" :false)))
        (funcall (nth 2 (car requests))
                 '(:ok nil :error-code "timeout" :error-message "请求超时"))
        (should (equal (caar requests) "GET"))
        (funcall (nth 2 (car requests))
                 '(:ok t :data ((conversation_id . "TTEST.CCHAT") (watching . :false))))
        (should (string-suffix-p "〔未关注〕" header-line-format))
        (should (equal (buffer-string) "草稿"))
        (should (= (point) (point-min))))
      (setq-local loki-assistant-slack--thread-root "101.0")
      (should-not (eq (key-binding key) #'loki-assistant-slack-toggle-watch)))))

(ert-deftest loki-assistant-slack-chat-test-marks-visible-timelines-read ()
  (with-temp-buffer
    (let ((loki-assistant-slack--room '((id . "TTEST.DCHAT") (session_id . "one")))
          requests)
      (insert (propertize "根消息\n" 'loki-slack-message "101.0")
              (propertize "已展开回复\n" 'loki-slack-message "105.0" 'loki-slack-root "101.0")
              (propertize "已折叠回复\n" 'loki-slack-message "107.0" 'loki-slack-root "101.0" 'invisible t)
              (propertize "下一条消息\n" 'loki-slack-message "104.0")
              (propertize "尚未显示完整的消息\n" 'loki-slack-message "108.0"))
      (let ((limit (- (point-max) 2)))
        (cl-letf (((symbol-function 'window-start) (lambda (_) (point-min)))
                  ((symbol-function 'window-end) (lambda (&rest _) limit))
                  ((symbol-function 'pos-visible-in-window-p) (lambda (&rest _) t))
                  ((symbol-function 'loki-assistant-slack--request)
                   (lambda (method path callback &rest args)
                     (should (equal method "PUT"))
                     (push (list path (alist-get 'through_ts (plist-get args :body)) callback)
                           requests))))
          (let ((visible (loki-assistant-slack--visible-read-positions nil)))
            (should (equal (gethash nil visible) "104.0"))
            (should (equal (gethash "101.0" visible) "105.0"))
            (maphash #'loki-assistant-slack--mark-read visible)
            (maphash #'loki-assistant-slack--mark-read visible))
          (should (= 2 (length requests)))
          (let ((timeline (assoc "/slack/conversations/TTEST.DCHAT/read-position" requests))
                (thread (assoc "/slack/conversations/TTEST.DCHAT/threads/101.0/read-position"
                               requests)))
            (should (equal (cadr timeline) "104.0"))
            (should (equal (cadr thread) "105.0"))
            (funcall (nth 2 timeline) '(:ok t))
            (loki-assistant-slack--mark-read nil "101.0")
            (should (= 2 (length requests)))
            (loki-assistant-slack--mark-read nil "108.0")
            (should (= 3 (length requests)))))))))

(ert-deftest loki-assistant-slack-chat-test-shows-local-time-at-message-end ()
  (let ((now (encode-time 0 15 0 1 1 2026))
        (yesterday (encode-time 0 55 23 31 12 2025))
        (earlier (encode-time 0 42 16 30 12 2025)))
    (cl-letf (((symbol-function 'current-time) (lambda () now)))
      (should (equal (loki-assistant-slack--message-time now) "今天 00:15"))
      (should (equal (loki-assistant-slack--message-time yesterday) "昨天 23:55"))
      (should (equal (loki-assistant-slack--message-time earlier) "2025年12月30日 16:42"))
      (with-temp-buffer
        (loki-assistant-slack--message
         `((ts . ,(number-to-string (time-convert yesterday 'integer)))
           (text . "<https://example.com|报告>"))
         nil (make-hash-table :test #'equal))
        (goto-char (point-min))
        (should (looking-at-p "报告   昨天 23:55 \n"))
        (should (button-at (point)))
        (search-forward "昨天 23:55")
        (should-not (button-at (1- (point))))
        (should (eq (get-text-property (1- (point)) 'face) 'loki-assistant-slack-message-time))))
    (cl-letf (((symbol-function 'current-time) (lambda () (encode-time 0 0 12 3 1 2026))))
      (should (equal (loki-assistant-slack--message-time now) "01月01日 00:15")))))

(ert-deftest loki-assistant-slack-chat-test-renders-message-content ()
  (skip-unless (require 'agent-shell-markdown nil t))
  (let ((profiles (make-hash-table :test #'equal))
        (image '(image :type png))
        (avatar '(image :type png :width 20))
        (room '((id . "TTEST.CCHAT") (team_id . "TTEST") (session_id . "local")))
        (message '((ts . "104.0") (author . ((id . "TTEST.U1") (name . "U1")))
                   (text . "请看 <https://example.com/report|版本报告|新版>，<@U1>。\n<!here> 和 &lt;占位&gt;\n:wave: <slack://preferences?section=shortcuts|首选项>\nEmail: <mailto:contact@example.com|contact@example.com>\n<file:///tmp/private|本机路径> [本机文件](file:///tmp/private)")
                   (tables . [[ ["版本" "成功率"] ["3.3.107" "99.5%"] ]])
                   (attachments . [((title . "报告截图.png") (size . 4096) (image . t)
                                    (preview_path . "/fixture/preview.png")
                                    (url . "https://workspace.slack.com/files/F1"))
                                   ((title . "没有缓存的图片") (image . t)
                                    (url . "https://workspace.slack.com/files/F2"))]))))
    (puthash "TTEST.U1" '((name . "林舟") (avatar_path . "/fixture/avatar.png")) profiles)
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
              ((symbol-function 'loki-assistant-slack--file-image)
               (lambda (path width height)
                 (cond ((equal path "/fixture/avatar.png")
                        (should (equal (list width height) '(20 20))) avatar)
                       ((equal path "/fixture/preview.png")
                        (should (equal (list width height) '(560 320))) image)
                       (t (should-not path)))))
              ((symbol-function 'loki-assistant-slack--request)
               (lambda (&rest _) (ert-fail "渲染期间请求了 services")))
              ((symbol-function 'url-retrieve)
               (lambda (&rest _) (ert-fail "渲染期间请求了网络图片"))))
      (with-temp-buffer
        (let ((loki-assistant-slack--self-id "TTEST.U1"))
          (loki-assistant-slack--history (make-loki-assistant-slack--page :items (list message))
                                         room profiles))
        (let ((prompt (point)))
          (insert loki-assistant-slack--prompt)
          (loki-assistant-slack--decorate prompt (point))
          (dolist (position (list (point-min) (1- prompt)))
            (let ((label (get-char-property position 'before-string)))
              (should (equal label " ○ 我 \n"))
              (should (eq (get-text-property 1 'display label) avatar))
              (should (eq (get-text-property 3 'face label) 'loki-assistant-slack-self-label)))))
        (goto-char (loki-assistant-slack--message-position "104.0"))
        (should (looking-at-p "请看"))
        (should (string-match-p "[0-9-]+ [0-9:]+" (get-text-property (point) 'help-echo)))
        (should (text-property-any (point-min) (point-max) 'display image))
        (should (= 1 (how-many "没有缓存的图片" (point-min) (point-max))))
        (should-not (loki-assistant-slack--profile-avatar
                     '((avatar_url . "https://avatars.slack-edge.com/example.png"))))
        (should (text-property-not-all (point-min) (point-max) 'agent-shell-markdown-table-source nil))
        (goto-char (point-min))
        (search-forward "版本报告|新版")
        (should (button-at (1- (point))))
        (search-forward "@林舟")
        (search-forward "<!here> 和 <占位>")
        (search-forward "👋 首选项")
        (should (equal (button-get (button-at (1- (point))) 'help-echo)
                       "slack://preferences?section=shortcuts"))
        (search-forward "Email: contact@example.com")
        (let ((button (button-at (1- (point))))
              opened)
          (should button)
          (cl-letf (((symbol-function 'browse-url) (lambda (url &rest _) (setq opened url))))
            (button-activate button))
          (should (equal opened "mailto:contact@example.com")))
        (search-forward "本机路径")
        (should-not (button-at (1- (point))))
        (search-forward "本机文件")
        (should-not (button-at (1- (point))))
        (search-forward "报告截图.png")
        (should (button-at (1- (point))))))))

(ert-deftest loki-assistant-slack-chat-test-renders-message-blocks ()
  (skip-unless (require 'agent-shell-markdown nil t))
  (let ((profiles (make-hash-table :test #'equal))
        (room '((team_id . "TTEST")))
        (message '((ts . "104.0") (text . "未处理的告警")
                   (blocks . [((type . "section")
                               (text . ((type . "mrkdwn")
                                        (text . "&gt;值班 <@U1>: *<https://example.com/alerts|IP绑定不通>*\n&gt;已持续0.4小时: `IP无法连通`"))))
                              ((type . "table") (rows . [["分组"] ["仅显示一次"]]))
                              ((type . "unknown"))
                              ((type . "section")
                               (fields . [((type . "plain_text") (text . "*字面量* &lt;@U2&gt; &amp;lt;"))
                                          ((type . "mrkdwn") (text . "&gt;<@U3>: *节点记录冲突*\n&gt;`<@U4>`"))]))])
                   (tables . [[["分组"] ["仅显示一次"]]]) (attachments . [((title . "值班报告"))]))))
    (puthash "TTEST.U1" '((name . "林舟")) profiles)
    (should (equal (sort (loki-assistant-slack--block-users message "TTEST") #'string<)
                   '("TTEST.U1" "TTEST.U3")))
    (with-temp-buffer
      (loki-assistant-slack--message message room profiles)
      (goto-char (point-min))
      (should-not (search-forward "未处理的告警" nil t))
      (search-forward "值班 @林舟")
      (should (get-text-property (1- (point)) 'agent-shell-markdown-blockquote-rendered))
      (search-forward "IP绑定不通")
      (should (equal (button-get (button-at (1- (point))) 'help-echo) "https://example.com/alerts"))
      (should (memq 'agent-shell-markdown-bold (get-text-property (1- (point)) 'face)))
      (search-forward "IP无法连通")
      (let ((face (get-text-property (1- (point)) 'face)))
        (should (memq 'agent-shell-markdown-inline-code (if (listp face) face (list face)))))
      (search-forward "仅显示一次")
      (should (= 1 (how-many "仅显示一次" (point-min) (point-max))))
      (search-forward "*字面量* <@U2> &lt;")
      (search-forward "@U3: 节点记录冲突")
      (let ((face (get-text-property (1- (point)) 'face)))
        (should (memq 'agent-shell-markdown-bold (if (listp face) face (list face)))))
      (search-forward "<@U4>")
      (search-forward "值班报告"))
    (with-temp-buffer
      (loki-assistant-slack--message-body
       '((text . "保留正文") (blocks . [((type . "table") (rows . [["表格内容"]]))]))
       "TTEST" profiles)
      (goto-char (point-min))
      (search-forward "保留正文")
      (search-forward "表格内容"))))

(ert-deftest loki-assistant-slack-chat-test-reads-local-message-cache ()
  (let* ((path (make-temp-file "loki-slack-message-"))
         (entry `((ts . "10.000001") (text . "HTTP 正文") (cache_path . ,path))))
    (unwind-protect
        (progn
          (with-temp-file path
            (insert "((ts . \"10.000001\") (text . \"缓存正文\") (edited . :false))\n"))
          (should (equal (alist-get 'text (loki-assistant-slack--cached-record entry 'ts "10.000001" '(text)))
                         "缓存正文"))
          (let* ((blocks [((type . "section") (text . ((type . "plain_text") (text . "实时正文"))))])
                 (message (cons (cons 'blocks blocks) entry))
                 (items (loki-assistant-slack--merge nil (list (cons 'items (list message))))))
            (should (equal (alist-get 'blocks (car items)) blocks)))
          (with-temp-file path (insert "((ts . \"10.000001\")"))
          (should (equal (loki-assistant-slack--cached-record entry 'ts "10.000001" '(text)) entry))
          (delete-file path)
          (should (equal (loki-assistant-slack--cached-record entry 'ts "10.000001" '(text)) entry)))
      (when (file-exists-p path) (delete-file path)))))

