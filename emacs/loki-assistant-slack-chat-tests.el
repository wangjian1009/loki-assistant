              (with-current-buffer thread-buffer
                (should (equal (buffer-substring-no-properties (loki-assistant-slack--draft-start) (point-max))
                               "q线程新回复"))
                (goto-char (point-max))
                (execute-kbd-macro (kbd "S-<return>"))
                (insert "第二行")
