;;; loki-assistant-llm-usage-tests.el --- LLM 用量查询测试 -*- lexical-binding: t; -*-

(require 'ert)
(require 'loki-assistant-llm-usage)

(ert-deftest loki-assistant-llm-usage-test-drill-into-filtered-month ()
  (with-temp-buffer
    (loki-assistant-llm-usage-mode)
    (let ((requests nil)
          (overview '((bucket . "month") (group_by . "upstream")
                      (from_date . "2026-11-15") (to_date . "2026-11-26")
                      (protocol . "codex"))))
      (setf (loki-assistant-llm-usage--view-filters
             (loki-assistant-llm-usage--state)) overview)
      (cl-letf (((symbol-function 'loki-assistant-request)
                 (lambda (_method path &rest options)
                   (push (cons path (plist-get options :params)) requests)
                   (funcall (plist-get options :callback)
                            (list :ok t :data
                                  (if (equal path "/llm/usage/summary")
                                      '((bucket . "month") (group_by . "upstream")
                                        (from_date . "2026-11-15") (to_date . "2026-11-26")
                                        (time_zone . "Asia/Shanghai")
                                        (totals . ((requests . 1) (incomplete_requests . 1)
                                                   (input_uncached_tokens . 1234567)
                                                   (cache_read_tokens . 0) (cache_write_tokens . 0)
                                                   (output_tokens . 2)))
                                        (items . [((period_start . "2026-11-01")
                                                   (group . "work") (input_uncached_tokens . 6)
                                                   (output_tokens . 2))
                                                  ((period_start . "2026-11-01")
                                                   (group . "other") (cache_read_tokens . 4))]))
                                    '((items . []) (next_cursor . :null))))))))
        (loki-assistant-llm-usage--load)
        (goto-char (point-min))
        (should (looking-at-p "统计范围  2026-11-15 至 2026-11-25（含首尾）"))
        (should-not (tabulated-list-header-overlay-p))
        (should (search-forward "未缓存 1,234,567" nil t))
        (should (search-forward "按月明细" nil t))
        (forward-line 1)
        (should (tabulated-list-header-overlay-p (point)))
        (should (search-forward "2026-11 " nil t))
        (beginning-of-line)
        (should (equal (tabulated-list-get-id) '("2026-11-01" "work")))
        (call-interactively (key-binding (kbd "t")))
        (should (string-match-p "按月用量图  ·  满格 8 token" (buffer-string)))
        (should (equal (tabulated-list-get-id) '("2026-11-01" "work")))
        (should (equal (aref (cadar tabulated-list-entries) 2)
                       (concat (make-string 24 ?█) (make-string 8 ?░))))
        (should (equal (aref (cadadr tabulated-list-entries) 2) (make-string 16 ?▓)))
        (should (equal (mapcar #'car requests) '("/llm/usage/summary")))
        (loki-assistant-llm-usage-open)
        (should (equal (caar requests) "/llm/usage/requests"))
        (should (equal (cdr (assoc "from" (cdar requests))) "2026-11-14T16:00:00Z"))
        (should (equal (cdr (assoc "to" (cdar requests))) "2026-11-25T16:00:00Z"))
        (should (equal (cdr (assoc "upstream" (cdar requests))) "work"))
        (should (equal (cdr (assoc "protocol" (cdar requests))) "codex"))
        (loki-assistant-llm-usage-back)
        (should (eq loki-assistant-llm-usage--current 'overview))
        (should (string-match-p "按月用量图" (buffer-string)))
        (should (equal (loki-assistant-llm-usage--view-filters
                        (loki-assistant-llm-usage--state)) overview))
        (call-interactively (key-binding (kbd "t")))
        (should (string-match-p "按月明细" (buffer-string)))))))

(ert-deftest loki-assistant-llm-usage-test-discards-late-pages ()
  (with-temp-buffer
    (loki-assistant-llm-usage-mode)
    (setq loki-assistant-llm-usage--current 'history)
    (let ((callbacks nil))
      (cl-letf (((symbol-function 'loki-assistant-request)
                 (lambda (_method _path &rest options)
                   (push (plist-get options :callback) callbacks))))
        (loki-assistant-llm-usage-refresh)
        (funcall (pop callbacks)
                 '(:ok t :data ((items . [((id . "first"))]) (next_cursor . "cursor"))))
        (loki-assistant-llm-usage-more)
        (loki-assistant-llm-usage-refresh)
        (funcall (pop callbacks)
                 '(:ok t :data ((items . [((id . "new") (client_name . "editor"))
                                          ((id . "deleted") (client_name . :null))])
                                (next_cursor . :null))))
        (funcall (pop callbacks)
                 '(:ok t :data ((items . [((id . "old-page"))]) (next_cursor . :null))))
        (should (equal (mapcar (lambda (item) (alist-get 'id item))
                               (loki-assistant-llm-usage--view-items
                                (loki-assistant-llm-usage--state)))
                       '("new" "deleted")))
        (should (equal (car (aref tabulated-list-format 1)) "客户端"))
        (should (equal (aref (cadar tabulated-list-entries) 1) "editor"))
        (should (equal (aref (cadadr tabulated-list-entries) 1) "未知客户端"))))))

(ert-deftest loki-assistant-llm-usage-test-live-displays-null-and-reported-usage ()
  (with-temp-buffer
    (loki-assistant-llm-usage-mode)
    (cl-letf (((symbol-function 'loki-assistant-request)
               (lambda (method path &rest options)
                 (should (equal method "GET"))
                 (should (equal path "/llm/requests"))
                 (should (equal frame-title-format "LLM 用量 · 实时请求"))
                 (should (string-match-p "1-5 切换" (format-mode-line mode-line-process)))
                 (should (eq (key-binding (kbd "C-c C-q")) #'quit-window))
                 (funcall
                  (plist-get options :callback)
                  '(:ok t :data
                    ((client_names . ((editor-id . "editor")))
                     (active . [((id . "active") (client_id . "editor-id") (phase . "responding")
                                 (has_detail . t)
                                 (usage . :null))])
                     (recent . [((id . "recent") (phase . "completed")
                                 (has_detail . :false)
                                 (usage . ((output_tokens . 0) (complete . t))))])))))))
      (call-interactively (key-binding (kbd "5")))
      (should (equal (mapcar #'car tabulated-list-entries) '("active" "recent")))
      (let ((active (cadar tabulated-list-entries))
            (recent (cadadr tabulated-list-entries)))
        (should (equal (aref active 1) "editor"))
        (should (equal (aref active 2) "接收响应"))
        (should (equal (aref active 3) "可查看"))
        (should (equal (aref active 8) "—"))
        (should (equal (aref active 9) "—"))
        (should (equal (aref recent 3) "—"))
        (should (equal (aref recent 8) "0"))
        (should (equal (aref recent 9) "完整"))))))

(ert-deftest loki-assistant-llm-usage-test-opens-live-detail-by-id ()
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (loki-assistant-llm-usage-mode)
      (setq loki-assistant-llm-usage--current 'live)
      (let ((callbacks nil) (opened nil))
        (setf (loki-assistant-llm-usage--view-items (loki-assistant-llm-usage--state))
              '(((id . "first")) ((id . "second"))))
        (loki-assistant-llm-usage--render)
        (cl-letf (((symbol-function 'loki-assistant-request)
                   (lambda (method path &rest options)
                     (should (equal method "GET"))
                     (push (cons path (plist-get options :callback)) callbacks)))
                  ((symbol-function 'loki-assistant-llm-usage--detail)
                   (lambda (data live) (push (list data live) opened))))
          (goto-char (point-min))
          (loki-assistant-llm-usage-open)
          (forward-line 1)
          (loki-assistant-llm-usage-open)
          (should (equal (mapcar #'car callbacks)
                         '("/llm/requests/second" "/llm/requests/first")))
          (funcall (cdar callbacks) '(:ok t :data ((item . ((id . "second"))))))
          (funcall (cdadr callbacks) '(:ok t :data ((item . ((id . "first"))))))
          (should (equal opened '((((item . ((id . "second")))) t)))))))))

(ert-deftest loki-assistant-llm-usage-test-folds-and-copies-instructions ()
  (with-temp-buffer
    (loki-assistant-llm-usage-detail-mode)
    (let ((inhibit-read-only t)
          (kill-ring nil)
          (interprogram-cut-function nil))
      (loki-assistant-llm-usage--insert-instructions
       '((status . "captured") (count . 3)
         (blocks . [((source . "instructions") (text . "顶层示例"))
                    ((source . "input[0]") (role . "system") (text . "系统示例"))
                    ((source . "input[1].content[0].text") (role . "developer")
                     (text . "原始\n开发者示例"))])))
      (goto-char (point-min))
      (should (looking-at-p "▶ 系统指令 · 3 段"))
      (let ((group (loki-assistant-llm-usage--instruction-at-point)))
        (should (invisible-p (overlay-start group)))
        (should-error (call-interactively (key-binding (kbd "TAB"))) :type 'user-error)
        (call-interactively (key-binding (kbd "RET")))
        (should (equal (get-text-property (point) 'display) "▼"))
        (call-interactively (key-binding (kbd "TAB")))
        (should (looking-at-p "  ▶ instructions 顶层示例$"))
        (call-interactively (key-binding (kbd "<backtab>")))
        (should (looking-at-p "▶ 系统指令 · 3 段")))
      (search-forward "1.0 developer 原始")
      (beginning-of-line)
      (should (looking-at-p "  ▶ 1\\.0 developer 原始$"))
      (save-excursion
        (search-forward " developer ")
        (let ((role-start (- (point) (length "developer "))))
          (should (memq 'loki-assistant-llm-usage-instruction-role
                        (ensure-list (get-text-property role-start 'face))))
          (should (equal (get-text-property role-start 'help-echo)
                         "input[1].content[0].text"))
          (should-not (memq 'loki-assistant-llm-usage-instruction-role
                            (ensure-list (get-text-property (point) 'face))))))
      (let ((body (loki-assistant-llm-usage--instruction-at-point)))
        (should (invisible-p (overlay-start body)))
        (call-interactively (key-binding (kbd "RET")))
        (should-not (invisible-p (overlay-start body)))
        (call-interactively (key-binding (kbd "w")))
        (should (equal (current-kill 0) "原始\n开发者示例"))
        (call-interactively (key-binding (kbd "<return>")))
        (should (invisible-p (overlay-start body)))
        (call-interactively (key-binding (kbd "C-M-u")))
        (should (looking-at-p "▶ 系统指令 · 3 段"))
        (call-interactively (key-binding (kbd "RET")))
        (funcall (overlay-get body 'isearch-open-invisible) body)
        (should-not (invisible-p (overlay-start body)))))))

(ert-deftest loki-assistant-llm-usage-test-usage-displays-and-filters-by-client-name ()
  (with-temp-buffer
    (loki-assistant-llm-usage-mode)
    (let ((data '((client_names . ((editor-id . "editor"))) (group_by . "client_id")))
          (row '((client_id . "editor-id") (group . "editor-id") (session_id . "session"))))
      (dolist (view '(overview sessions totals))
        (setq loki-assistant-llm-usage--current view)
        (let ((state (loki-assistant-llm-usage--state)))
          (setf (loki-assistant-llm-usage--view-data state) data
                (loki-assistant-llm-usage--view-items state) (list row)
                (loki-assistant-llm-usage--view-filters state) '((client_id . "editor-id")))
          (loki-assistant-llm-usage--render)
          (should (equal (aref (cadar tabulated-list-entries) (if (eq view 'totals) 0 1))
                         "editor"))
          (should (string-match-p "筛选  客户端 editor" (buffer-string)))
          (should-not (string-match-p "editor-id" (buffer-string)))))
      (cl-letf (((symbol-function 'completing-read)
                 (lambda (_prompt choices &rest _)
                   (should (equal (mapcar #'car choices) '("" "editor" "未知客户端（1）")))
                   "editor")))
        (should (equal
                 (loki-assistant-llm-usage--choose-client
                  '(((value . "editor-id")) ((value . "deleted-id"))) data nil)
                 "editor-id"))))))

(ert-deftest loki-assistant-llm-usage-test-exports-filtered-chart-png ()
  (skip-unless (executable-find "rsvg-convert"))
  (let* ((directory (make-temp-file "loki-llm-usage-png-" t))
         (name (expand-file-name "用量 报表" directory))
         (target (concat name ".png"))
         (signature (unibyte-string 137 80 78 71 13 10 26 10)))
    (unwind-protect
        (with-temp-buffer
          (loki-assistant-llm-usage-mode)
          (let* ((state (loki-assistant-llm-usage--state))
                 (data '((bucket . "day") (from_date . "2026-11-25")
                         (to_date . "2026-11-26") (group_by . "client_id")
                         (client_names . ((editor . "Emacs & Code")))))
                 (items '(((period_start . "2026-11-25") (group . "editor")
                           (cache_read_tokens . 200) (output_tokens . 10)
                           (incomplete_requests . 1))))
                 (filters '((upstream . "work"))))
            (setf (loki-assistant-llm-usage--view-data state) data
                  (loki-assistant-llm-usage--view-items state) items
                  (loki-assistant-llm-usage--view-filters state) filters)
            (let ((svg (loki-assistant-llm-usage--chart-svg data items filters)))
              (with-temp-buffer
                (svg-print svg)
                (should (search-backward "Emacs &amp; Code" nil t))
                (should (search-backward "work" nil t))))
            (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) name)))
              (should (equal (call-interactively (key-binding (kbd "e"))) target)))
            (cl-letf (((symbol-function 'call-process-region) (lambda (&rest _) 1)))
              (should-error (loki-assistant-llm-usage-export-png target) :type 'user-error))
            (should (equal (directory-files directory nil "^[^.]" 'nosort)
                           '("用量 报表.png")))
            (should-not (directory-files directory nil "^\\.llm-usage-"))
            (with-temp-buffer
              (set-buffer-multibyte nil)
              (insert-file-contents-literally target nil 0 8)
              (should (equal (buffer-string) signature)))))
      (delete-directory directory t))))

(ert-deftest loki-assistant-llm-usage-test-live-transcript-uses-full-window ()
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (loki-assistant-llm-usage-mode)
      (setq loki-assistant-llm-usage--current 'live)
      (delete-other-windows)
      (split-window-below)
      (let ((origin (current-buffer))
            (detail (generate-new-buffer " *LLM 测试详情*"))
            (create-buffer (symbol-function 'get-buffer-create)))
        (unwind-protect
            (progn
              (cl-letf (((symbol-function 'get-buffer-create)
                         (lambda (name &rest args)
                           (if (equal name "*LLM 请求详情*") detail
                             (apply create-buffer name args)))))
                (loki-assistant-llm-usage--detail
                 '((item . ((id . "sample")
                            (model . "test-model")
                            (instructions . ((status . "captured") (count . 1)
                                             (blocks . [((source . "instructions") (text . "系统示例"))])))
                            (request_content . ((settings . ((tool_choice . "auto")))
                                                (tools . [((name . "read_file") (text . "{}"))])
                                                (blocks . [((kind . "message") (role . "user") (text . "历史任务"))
                                                           ((kind . "message") (role . "assistant") (text . "历史回答"))
                                                           ((kind . "message") (role . "user") (text . "查看文件"))
                                                           ((kind . "tool_result") (id . "previous")
                                                            (text . "前一次工具输出"))])))
                            (response_content . ((complete . t)
                                                 (blocks . [((kind . "tool_call") (name . "read_file")
                                                             (id . "call-1") (text . "{\"path\":\"README.org\"}"))
                                                            ((kind . "message") (role . "assistant")
                                                             (text . "**响应示例**"))])))))) t))
              (should (eq (current-buffer) detail))
              (should (one-window-p))
              (goto-char (point-min))
              (should (search-forward "历史对话 · 1 条用户消息 · 1 条助手消息" nil t))
              (should (search-forward "历史任务" nil t))
              (should (invisible-p (1- (point))))
              (should (search-forward "查看文件" nil t))
              (should-not (invisible-p (1- (point))))
              (should (search-forward "工具调用 · read_file · call-1" nil t))
              (should (search-forward "响应示例" nil t))
              (should-not (invisible-p (1- (point))))
              (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "本次响应")))
                (loki-assistant-llm-usage-jump-detail))
              (should (looking-at-p "本次响应 · 1 条助手消息 · 1 次工具调用$"))
              (call-interactively (key-binding (kbd "TAB")))
              (should (looking-at-p "▶ 工具调用 · read_file · call-1 · 参数$"))
              (should-not (invisible-p (point)))
              (let ((body (loki-assistant-llm-usage--instruction-at-point)))
                (should (invisible-p (overlay-start body))))
              (call-interactively (key-binding (kbd "q")))
              (should (eq (current-buffer) origin))
              (should (= (length (window-list)) 2)))
          (kill-buffer detail))))))

(ert-deftest loki-assistant-llm-usage-test-tool-only-response-visible ()
  (with-temp-buffer
    (loki-assistant-llm-usage-detail-mode)
    (let ((inhibit-read-only t))
      (loki-assistant-llm-usage--insert-transcript
       '((phase . "completed")
         (response_content . ((complete . t)
                              (blocks . [((kind . "tool_call") (name . "exec") (id . "call-2")
                                          (text . "{\"cmd\":\"pwd\"}"))])))))
      (goto-char (point-min))
      (should (search-forward "本次响应 · 1 次工具调用" nil t))
      (call-interactively (key-binding (kbd "TAB")))
      (should (looking-at-p "▶ 工具调用 · exec · call-2 · 参数$"))
      (should-not (invisible-p (point)))
      (let ((body (loki-assistant-llm-usage--instruction-at-point)))
        (should (invisible-p (overlay-start body)))
        (call-interactively (key-binding (kbd "RET")))
        (should-not (invisible-p (overlay-start body)))))))

(ert-deftest loki-assistant-llm-usage-test-request-settings-align-on-expand ()
  (with-temp-buffer
    (loki-assistant-llm-usage-detail-mode)
    (let ((inhibit-read-only t))
      (loki-assistant-llm-usage--insert-transcript
       '((instructions . ((status . "captured") (count . 1)
                          (blocks . [((source . "instructions") (text . "系统示例"))])))
         (request_content . ((settings . ((parallel_tool_calls . t)
                                          (reasoning . ((effort . "high")))
                                          (stream . t)
                                          (tool_choice . "auto")))
                             (tools . [((name . "read_file") (text . "{}"))])))))
      (goto-char (point-min))
      (search-forward "▶ 请求上下文")
      (beginning-of-line)
      (loki-assistant-llm-usage-fold-instruction)
      (loki-assistant-llm-usage-next-item)
      (should (looking-at-p "  ▶ 系统指令"))
      (loki-assistant-llm-usage-next-item)
      (should (looking-at-p "  ▶ 请求设置 · 4 项$"))
      (let ((settings (point)))
        (loki-assistant-llm-usage-fold-instruction)
        (should (= (point) settings))
        (should (looking-at-p "  ▶ 请求设置 · 4 项$"))
        (dolist (field '("parallel_tool_calls" "reasoning" "stream" "tool_choice"))
          (loki-assistant-llm-usage-next-item)
          (should (looking-at-p (concat "    ▶ " field "$"))))
        (loki-assistant-llm-usage-next-item)
        (should (looking-at-p "  ▶ 工具定义"))
        (should-not (text-property-not-all (point-min) (point-max) 'line-prefix nil))))))

(ert-deftest loki-assistant-llm-usage-test-renders-org-response-and-copies-original ()
  (with-temp-buffer
    (loki-assistant-llm-usage-detail-mode)
    (let* ((inhibit-read-only t)
           (kill-ring nil)
           (interprogram-cut-function nil)
           (fence (make-string 3 #x60))
           (original (concat fence "org\n* 验证结果\n使用 ~make test~ 验证。\n" fence)))
      (loki-assistant-llm-usage--insert-transcript-block
       (list '(kind . "message") '(role . "assistant") (cons 'text original)))
      (goto-char (point-min))
      (loki-assistant-llm-usage-copy-instruction)
      (should (equal (current-kill 0) original))
      (should (search-forward "验证结果" nil t))
      (should (eq (get-text-property (1- (point)) 'face) 'org-level-1))
      (should-not (string-match-p fence (buffer-string))))))

(ert-deftest loki-assistant-llm-usage-test-reenables-a-recent-monitoring-filter ()
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (loki-assistant-llm-usage-mode)
      (setq loki-assistant-llm-usage--current 'live)
      (let ((filter '((protocols . ["codex"])
                      (clients . ["1c30befd-aacd-419b-b0f3-8d72680d275b"])
                      (upstreams . ["work" "personal"])))
            saved)
        (cl-letf (((symbol-function 'loki-assistant-request)
                   (lambda (method path &rest options)
                     (should (equal path "/llm/monitoring"))
                     (if (equal method "GET")
                         (funcall (plist-get options :callback)
                                  (list :ok t :data
                                        (list (cons 'history (vector filter)))))
                       (should (equal method "PATCH"))
                       (setq saved (plist-get options :body)))))
                  ((symbol-function 'completing-read)
                   (lambda (_prompt choices &rest _)
                     (car (seq-find (lambda (choice)
                                      (string-prefix-p "最近 1 ·" (car choice))) choices)))))
          (call-interactively (key-binding (kbd "m")))
          (should (equal saved (list (cons 'filter filter)))))))))

