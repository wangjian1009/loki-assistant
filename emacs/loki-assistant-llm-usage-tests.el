;;; loki-assistant-llm-usage-tests.el --- LLM 用量查询测试 -*- lexical-binding: t; -*-

(require 'ert)
(require 'loki-assistant-llm-usage)

(ert-deftest loki-assistant-llm-usage-test-drill-into-filtered-month ()
  (with-temp-buffer
    (loki-assistant-llm-usage-mode)
    (let ((requests nil)
          (overview '((bucket . "month") (group_by . "upstream")
                      (from_date . "2026-11-15") (to_date . "2026-11-26")
                      (protocol . "codex"))))
      (setf (loki-assistant-llm-usage--view-filters
             (loki-assistant-llm-usage--state)) overview)
      (cl-letf (((symbol-function 'loki-assistant-request)
                 (lambda (_method path &rest options)
                   (push (cons path (plist-get options :params)) requests)
                   (funcall (plist-get options :callback)
                            (list :ok t :data
                                  (if (equal path "/llm/usage/summary")
                                      '((bucket . "month") (group_by . "upstream")
                                        (from_date . "2026-11-15") (to_date . "2026-11-26")
                                        (time_zone . "Asia/Shanghai")
                                        (totals . ((requests . 1) (incomplete_requests . 1)
                                                   (input_uncached_tokens . 1234567)
                                                   (cache_read_tokens . 0) (cache_write_tokens . 0)
                                                   (output_tokens . 2)))
                                        (items . [((period_start . "2026-11-01")
                                                   (group . "work") (input_uncached_tokens . 6)
                                                   (output_tokens . 2))
                                                  ((period_start . "2026-11-01")
                                                   (group . "other") (cache_read_tokens . 4))]))
                                    '((items . []) (next_cursor . :null))))))))
        (loki-assistant-llm-usage--load)
        (goto-char (point-min))
        (should (looking-at-p "统计范围  2026-11-15 至 2026-11-25（含首尾）"))
        (should-not (tabulated-list-header-overlay-p))
        (should (search-forward "未缓存 1,234,567" nil t))
        (should (search-forward "按月明细" nil t))
        (forward-line 1)
        (should (tabulated-list-header-overlay-p (point)))
        (should (search-forward "2026-11 " nil t))
        (beginning-of-line)
        (should (equal (tabulated-list-get-id) '("2026-11-01" "work")))
        (call-interactively (key-binding (kbd "t")))
        (should (string-match-p "按月用量图  ·  满格 8 token" (buffer-string)))
        (should (equal (tabulated-list-get-id) '("2026-11-01" "work")))
        (should (equal (aref (cadar tabulated-list-entries) 2)
                       (concat (make-string 24 ?█) (make-string 8 ?░))))
        (should (equal (aref (cadadr tabulated-list-entries) 2) (make-string 16 ?▓)))
        (should (equal (mapcar #'car requests) '("/llm/usage/summary")))
        (loki-assistant-llm-usage-open)
        (should (equal (caar requests) "/llm/usage/requests"))
        (should (equal (cdr (assoc "from" (cdar requests))) "2026-11-14T16:00:00Z"))
        (should (equal (cdr (assoc "to" (cdar requests))) "2026-11-25T16:00:00Z"))
        (should (equal (cdr (assoc "upstream" (cdar requests))) "work"))
        (should (equal (cdr (assoc "protocol" (cdar requests))) "codex"))
        (loki-assistant-llm-usage-back)
        (should (eq loki-assistant-llm-usage--current 'overview))
        (should (string-match-p "按月用量图" (buffer-string)))
        (should (equal (loki-assistant-llm-usage--view-filters
                        (loki-assistant-llm-usage--state)) overview))
        (call-interactively (key-binding (kbd "t")))
        (should (string-match-p "按月明细" (buffer-string)))))))

(ert-deftest loki-assistant-llm-usage-test-discards-late-pages ()
  (with-temp-buffer
    (loki-assistant-llm-usage-mode)
    (setq loki-assistant-llm-usage--current 'history)
    (let ((callbacks nil))
      (cl-letf (((symbol-function 'loki-assistant-request)
                 (lambda (_method _path &rest options)
                   (push (plist-get options :callback) callbacks))))
        (loki-assistant-llm-usage-refresh)
        (funcall (pop callbacks)
                 '(:ok t :data ((items . [((id . "first"))]) (next_cursor . "cursor"))))
        (loki-assistant-llm-usage-more)
        (loki-assistant-llm-usage-refresh)
        (funcall (pop callbacks)
                 '(:ok t :data ((items . [((id . "new"))]) (next_cursor . :null))))
        (funcall (pop callbacks)
                 '(:ok t :data ((items . [((id . "old-page"))]) (next_cursor . :null))))
        (should (equal (mapcar (lambda (item) (alist-get 'id item))
                               (loki-assistant-llm-usage--view-items
                                (loki-assistant-llm-usage--state)))
                       '("new")))))))

(ert-deftest loki-assistant-llm-usage-test-live-displays-null-and-reported-usage ()
  (with-temp-buffer
    (loki-assistant-llm-usage-mode)
    (cl-letf (((symbol-function 'loki-assistant-request)
               (lambda (method path &rest options)
                 (should (equal method "GET"))
                 (should (equal path "/llm/requests"))
                 (funcall
                  (plist-get options :callback)
                  '(:ok t :data
                    ((active . [((id . "active") (phase . "responding")
                                 (usage . :null))])
                     (recent . [((id . "recent") (phase . "completed")
                                 (usage . ((output_tokens . 0) (complete . t))))])))))))
      (call-interactively (key-binding (kbd "5")))
      (should (equal (mapcar #'car tabulated-list-entries) '("active" "recent")))
      (let ((active (cadar tabulated-list-entries))
            (recent (cadadr tabulated-list-entries)))
        (should (equal (aref active 3) "接收响应"))
        (should (equal (aref active 6) "—"))
        (should (equal (aref active 7) "—"))
        (should (equal (aref recent 6) "0"))
        (should (equal (aref recent 7) "完整"))))))

(ert-deftest loki-assistant-llm-usage-test-exports-filtered-chart-png ()
  (skip-unless (executable-find "rsvg-convert"))
  (let* ((directory (make-temp-file "loki-llm-usage-png-" t))
         (name (expand-file-name "用量 报表" directory))
         (target (concat name ".png"))
         (signature (unibyte-string 137 80 78 71 13 10 26 10)))
    (unwind-protect
        (with-temp-buffer
          (loki-assistant-llm-usage-mode)
          (let* ((state (loki-assistant-llm-usage--state))
                 (data '((bucket . "day") (from_date . "2026-11-25")
                         (to_date . "2026-11-26") (group_by . "client_id")
                         (client_names . ((editor . "Emacs & Code")))))
                 (items '(((period_start . "2026-11-25") (group . "editor")
                           (cache_read_tokens . 200) (output_tokens . 10)
                           (incomplete_requests . 1))))
                 (filters '((upstream . "work"))))
            (setf (loki-assistant-llm-usage--view-data state) data
                  (loki-assistant-llm-usage--view-items state) items
                  (loki-assistant-llm-usage--view-filters state) filters)
            (let ((svg (loki-assistant-llm-usage--chart-svg data items filters)))
              (with-temp-buffer
                (svg-print svg)
                (should (search-backward "Emacs &amp; Code" nil t))
                (should (search-backward "work" nil t))))
            (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) name)))
              (should (equal (call-interactively (key-binding (kbd "e"))) target)))
            (cl-letf (((symbol-function 'call-process-region) (lambda (&rest _) 1)))
              (should-error (loki-assistant-llm-usage-export-png target) :type 'user-error))
            (should (equal (directory-files directory nil "^[^.]" 'nosort)
                           '("用量 报表.png")))
            (should-not (directory-files directory nil "^\\.llm-usage-"))
            (with-temp-buffer
              (set-buffer-multibyte nil)
              (insert-file-contents-literally target nil 0 8)
              (should (equal (buffer-string) signature)))))
      (delete-directory directory t))))

(provide 'loki-assistant-llm-usage-tests)
;;; loki-assistant-llm-usage-tests.el ends here
