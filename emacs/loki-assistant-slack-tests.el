;;; loki-assistant-slack-tests.el --- Slack 客户端测试 -*- lexical-binding: t; -*-

(require 'ert)
(require 'loki-assistant-slack)

(require 'loki-assistant-config)

(ert-deftest loki-assistant-slack-test-workflow-uses-declared-fields-and-actions ()
  (let ((item
         '((key . "records") (data_type . "list") (name . "设置")
           (requires_local_auth . t) (save_timeout_seconds . 650)
           (structure . ((id_field . "slug") (label_field . "name")
                         (add_label . "新增记录")
                         (fields . [((key . "team_id") (label . "工作区") (required . t))
                                    ((key . "slug") (label . "标识") (required . t)
                                     (default_template . "{team_id:lowercase}"))
                                    ((key . "name") (label . "名称") (required . t))])))))
        write)
    (with-temp-buffer
      (loki-assistant-config-mode)
      (cl-letf (((symbol-function 'loki-assistant--module-api-token) (lambda (_) "test-token"))
                ((symbol-function 'loki-assistant-request)
                 (lambda (method path &rest args)
                   (should-not (equal method "GET"))
                   (setq write (list method path args)))))
        (widget-insert "其他配置之前\n")
        (loki-assistant-config--record-insert
         "example" item
         '((records . ((value . [((slug . "alpha") (name . "现有记录") (team_id . "TALPHA"))])))))
        (widget-insert "其他配置之后\n")
        (let ((section (car loki-assistant-config--record-sections)))
          (should (string-match-p "现有记录" (buffer-string)))
          (loki-assistant-config--record-edit section nil)
          (let ((inputs (loki-assistant-config--record-section-inputs section)))
            (widget-value-set (cdr (assoc "team_id" inputs)) "TBETA")
            (widget-value-set (cdr (assoc "name" inputs)) "待保存"))
          (loki-assistant-config--record-render section)
          (should (equal (widget-value (cdr (assoc "name" (loki-assistant-config--record-section-inputs section))))
                         "待保存"))
          (should (string-prefix-p "其他配置之前\n" (buffer-string)))
          (should (string-suffix-p "其他配置之后\n" (buffer-string)))
          (loki-assistant-config--record-save section)
          (should (equal (cl-subseq write 0 2) '("PUT" "/data/example/records/tbeta")))
          (should (equal (plist-get (nth 2 write) :headers) '(("If-None-Match" . "*") ("Authorization" . "Bearer test-token"))))
          (should (equal (plist-get (nth 2 write) :timeout) 650))
          (let ((value (plist-get (nth 2 write) :body)))
            (should (equal (gethash "name" value) "待保存"))
            (should-not (gethash "slug" value)))
          (funcall (plist-get (nth 2 write) :callback)
                   '(:ok nil :error-message "记录已存在"))
          (should (string-match-p "记录已存在" (buffer-string)))
          (should (equal (widget-value (cdr (assoc "name" (loki-assistant-config--record-section-inputs section))))
                         "待保存")))))))

(ert-deftest loki-assistant-slack-test-merge-fresh-vs-cached ()
  (let* ((old '(((ts . "123.000001") (text . "旧正文"))
                ((ts . "123.000002") (text . "已删除"))))
         (item '((ts . "123.000001") (text . "新正文")))
         (fresh `((covered_range . ((from_ts . "123.000001") (through_ts . "123.000002")))
                  (items . [,item])))
         (cached `((covered_range . :null) (items . [,item]))))
    (should (equal (loki-assistant-slack--merge old fresh) (list item)))
    (should (equal (loki-assistant-slack--merge old cached) (list item (cadr old))))))

(ert-deftest loki-assistant-slack-test-retry-uses-same-thread-and-idempotency-key ()
  (let ((draft (generate-new-buffer " *Slack 草稿测试*"))
        (requests nil))
    (unwind-protect
        (with-current-buffer draft
          (loki-assistant-slack-draft-mode)
          (setq loki-assistant-slack--session "session"
                loki-assistant-slack--conversation "TALPHA.D1"
                loki-assistant-slack--thread "123.000001")
          (insert "收到")
          (cl-letf (((symbol-function 'loki-assistant-slack--request)
                     (lambda (method path callback &rest arguments)
                       (push (list method path arguments) requests)
                       (funcall callback
                                (pcase (length requests)
                                  (1 '(:status nil :error-code "timeout"))
                                  (2 '(:status 404 :error-code "slack-send-request-not-found"))
                                  (_ '(:ok t :data ((state . "unknown")))))))))
            (loki-assistant-slack-send))
          (pcase-let ((`(,retry ,query ,first) requests))
            (should (equal first retry))
            (should (equal (cadr first) "/slack/conversations/TALPHA.D1/threads/123.000001/messages"))
            (should (equal (cadr query)
                           (concat "/slack/send-requests/" (plist-get (nth 2 first) :key)))))
          (should (eq loki-assistant-slack--draft-state 'unknown))
          (should (equal (buffer-string) "收到")))
      (when (buffer-live-p draft) (kill-buffer draft)))))

(ert-deftest loki-assistant-slack-test-consult-opens-selected-chat ()
  (skip-unless (require 'consult nil t))
  (let ((loki-assistant-slack--selection 1)
        (rooms '(((id . "TALPHA.D1") (kind . "im") (title . "林舟")
                  (team_id . "TALPHA") (session_id . "one"))
                 ((id . "TALPHA.C1") (kind . "public_channel") (title . "项目讨论")
                  (team_id . "TALPHA") (session_id . "one"))
                 ((id . "TBETA.C1") (kind . "public_channel") (title . "项目讨论")
                  (team_id . "TBETA") (session_id . "two"))))
        opened)
    (cl-letf (((symbol-function 'completing-read)
               (lambda (_prompt _table &rest _) "#项目讨论 [TBETA.C1]"))
              ((symbol-function 'loki-assistant-slack--open-view)
               (lambda (&rest args) (setq opened args))))
      (loki-assistant-slack--choose-room (selected-window) 1 rooms))
    (should (equal opened '("TBETA" "two" "TBETA.C1" nil "#项目讨论")))))

(provide 'loki-assistant-slack-tests)
