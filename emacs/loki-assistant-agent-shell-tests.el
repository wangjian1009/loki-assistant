(ert-deftest loki-assistant-agent-shell-dropped-screenshot-preview ()
  "验证截图拖放与图片粘贴的预览、重名避让及会话项目缓存。"
  (skip-unless (display-graphic-p))
  (let* ((directory (make-temp-file "loki-assistant-screenshot-test-" t))
         (source-directory (expand-file-name "NSIRD_screencaptureui_test" directory))
         (source (expand-file-name "Shot.png" source-directory))
         (cache (expand-file-name "cache" directory))
         (shell-buffer (generate-new-buffer " *loki-assistant-screenshot-shell*"))
         (timestamp (encode-time 56 34 12 17 11 2026))
         (format-time (symbol-function 'format-time-string))
         (loki-assistant-agent-shell-file-copy-policy 'always-original)
         (png (base64-decode-string
               "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aS1sAAAAASUVORK5CYII="))
         inserted)
    (unwind-protect
        (progn
          (make-directory source-directory)
          (make-directory cache)
          (with-current-buffer shell-buffer
            (setq default-directory (file-name-as-directory directory)))
          (with-temp-file source
            (set-buffer-multibyte nil)
            (insert png))
          (cl-letf (((symbol-function 'format-time-string)
                     (lambda (format &optional time zone)
                       (funcall format-time format (or time timestamp) zone)))
                    ((symbol-function 'loki-assistant-agent-shell--data-dir)
                     (lambda () (expand-file-name "cache" default-directory)))
                    ((symbol-function 'agent-shell--shell-buffer)
                     (lambda (&rest _) shell-buffer))
                    ((symbol-function 'agent-shell-insert)
                     (lambda (&rest args)
                       (should (eq (plist-get args :shell-buffer) shell-buffer))
                       (push (plist-get args :text) inserted))))
            (with-temp-buffer
              (setq default-directory "/")
              (should (eq (loki-assistant-agent-shell--dnd-handler
                           (concat "file:" source) 'copy)
                          'private))
              (should (eq (loki-assistant-agent-shell--dnd-multi-handler
                           (list (concat "file://" source)) 'copy)
                          'private))
              (cl-letf (((symbol-function 'gui-get-selection)
                         (lambda (selection type)
                           (should (eq selection 'CLIPBOARD))
                           (when (eq type 'image/png) png))))
                (dolist (mode '(agent-shell-mode
                                agent-shell-viewport-edit-mode
                                agent-shell-viewport-view-mode))
                  (setq major-mode mode)
                  (let ((buffer-read-only (eq mode 'agent-shell-viewport-view-mode)))
                    (loki-assistant-agent-shell-yank-image))))))
          (delete-file source)
          (should (= (length inserted) 5))
          (cl-loop for text in (nreverse inserted)
                   for name in '("截图 - 2026-11-17 12-34-56.png"
                                 "截图 - 2026-11-17 12-34-56-1.png"
                                 "截图 - 2026-11-17 12-34-56-2.png"
                                 "截图 - 2026-11-17 12-34-56-3.png"
                                 "截图 - 2026-11-17 12-34-56-4.png")
                   for path = (expand-file-name name cache)
                   do (should (get-text-property 0 'agent-shell-context-image text))
                   do (should (eq (car (get-text-property 0 'display text)) 'image))
                   do (should (equal (image-size (get-text-property 0 'display text) t)
                                     '(1 . 1)))
                   do (should (equal (substring-no-properties text)
                                     (concat "@\"" path "\"")))
                   do (should (equal (with-temp-buffer
                                       (set-buffer-multibyte nil)
                                       (insert-file-contents-literally path)
                                       (buffer-string))
                                     png))))
      (kill-buffer shell-buffer)
      (delete-directory directory t))))

(ert-deftest loki-assistant-agent-shell-yank-image-without-image ()
  "验证剪贴板没有图片时不写缓存或插入文本，也不访问会话。"
  (with-temp-buffer
    (setq major-mode 'agent-shell-mode)
    (dolist (data '(nil "" "最终接口修改"))
      (cl-letf (((symbol-function 'gui-get-selection)
                 (lambda (&rest _) data))
                ((symbol-function 'agent-shell--shell-buffer)
                 (lambda (&rest _) (ert-fail "没有图片时不应访问会话")))
                ((symbol-function 'agent-shell-insert)
                 (lambda (&rest _) (ert-fail "没有图片时不应插入内容"))))
        (should-not (loki-assistant-agent-shell--clipboard-image))
        (should-error (loki-assistant-agent-shell-yank-image) :type 'user-error)))))

(ert-deftest loki-assistant-agent-shell-clipboard-image-fallback ()
  "验证 PNG 不可用时读取其他格式，并保留图片格式与原始字节。"
  (let ((bytes (unibyte-string ?I ?I 42 0 8 0 0 0)))
    (cl-letf (((symbol-function 'gui-get-selection)
               (lambda (_selection type)
                 (pcase type
                   ('image/png (error "不支持该剪贴板类型"))
                   ('image/tiff bytes)))))
      (should (equal (loki-assistant-agent-shell--clipboard-image)
                     (cons ".tiff" bytes))))))

(ert-deftest loki-assistant-agent-shell-screenshot-file-names ()
  "验证中英文截图文件名识别，普通图片和非图片保持原规则。"
  (dolist (name '("Screenshot 2026-11-17 at 12.34.56.png"
                  "Screen Shot 2026-11-17 at 12.34.56.png"
                  "截屏2026-11-17 12.34.56.png"
                  "截图 - 2026-11-17 12-34-56.png"
                  "屏幕快照 2026-11-17.png"
                  "螢幕截圖 2026-11-17.png"))
    (should (loki-assistant-agent-shell--screenshot-file-p name)))
  (should-not (loki-assistant-agent-shell--screenshot-file-p "design.png"))
  (should-not (loki-assistant-agent-shell--screenshot-file-p "截图说明.txt")))

(ert-deftest loki-assistant-agent-shell-viewport-dnd-hooks ()
  "验证 viewport 的编辑与查看模式接入拖放，重复设置不会叠加规则。"
  (require 'loki-assistant)
  (let ((agent-shell-mode-hook agent-shell-mode-hook)
        (agent-shell-viewport-edit-mode-hook agent-shell-viewport-edit-mode-hook)
        (agent-shell-viewport-view-mode-hook agent-shell-viewport-view-mode-hook)
        (loki-assistant-agent-shell-enabled t))
    (loki-assistant--setup-agent-shell)
    (dolist (hook '(agent-shell-viewport-edit-mode-hook
                    agent-shell-viewport-view-mode-hook))
      (should (memq #'loki-assistant-agent-shell--setup-dnd (symbol-value hook))))
    (with-temp-buffer
      (loki-assistant-agent-shell--setup-dnd)
      (let ((rules (copy-sequence dnd-protocol-alist)))
        (loki-assistant-agent-shell--setup-dnd)
        (should (equal rules dnd-protocol-alist))
        (should (eq (cdar rules)
                    (if (>= emacs-major-version 30)
                        #'loki-assistant-agent-shell--dnd-multi-handler
                      #'loki-assistant-agent-shell--dnd-handler)))))))

(ert-deftest loki-assistant-agent-shell-insert-files-preserves-cached-images ()
  "验证重复插入同名图片时使用递增序号，并保留已有缓存内容。"
  (let* ((directory (make-temp-file "loki-assistant-image-test-" t))
         (source (expand-file-name "image.png" directory))
         (cache (expand-file-name "cache" directory))
         (loki-assistant-agent-shell-file-copy-policy 'always-copy)
         inserted)
    (unwind-protect
        (progn
          (make-directory cache)
          (cl-letf (((symbol-function 'loki-assistant-agent-shell--data-dir)
                     (lambda () cache))
                    ((symbol-function 'agent-shell--shell-buffer)
                     #'current-buffer)
                    ((symbol-function 'agent-shell--get-files-context)
                     (lambda (&rest args) (plist-get args :files)))
                    ((symbol-function 'agent-shell-insert)
                     (lambda (&rest args)
                       (push (plist-get args :text) inserted))))
            (dotimes (number 3)
              (with-temp-file source
                (insert (format "image %d" number)))
              (loki-assistant-agent-shell--insert-files (list source))))
          (should (equal (nreverse inserted)
                         (mapcar (lambda (name)
                                   (list (expand-file-name name cache)))
                                 '("image.png" "image-1.png" "image-2.png"))))
          (cl-loop for name in '("image.png" "image-1.png" "image-2.png")
                   for number from 0
                   do (should (equal (with-temp-buffer
                                       (insert-file-contents
                                        (expand-file-name name cache))
                                       (buffer-string))
                                     (format "image %d" number)))))
      (delete-directory directory t))))

(ert-deftest loki-assistant-agent-shell-setup-remaps-viewport-yank ()
  "验证 viewport 编辑缓冲区使用扩展后的 yank 命令。"
  (let ((shell-binding
         (lookup-key agent-shell-mode-map [remap yank]))
        (viewport-binding
         (lookup-key agent-shell-viewport-edit-mode-map [remap yank])))
    (unwind-protect
        (cl-letf (((symbol-function 'loki-assistant-agent-shell--setup-dnd)
                   #'ignore)
                  ((symbol-function 'loki-assistant-agent-shell--setup-notifications)
                   #'ignore))
          (loki-assistant-agent-shell-setup)
          (should
           (eq (lookup-key agent-shell-viewport-edit-mode-map [remap yank])
               #'loki-assistant-agent-shell-yank)))
      (define-key agent-shell-mode-map [remap yank] shell-binding)
      (define-key agent-shell-viewport-edit-mode-map [remap yank]
                  viewport-binding))))

(ert-deftest loki-assistant-agent-shell-notify-uses-loki-assistant ()
  "验证 Agent 事件通知通过 Loki Assistant 发送。"
  (let (arguments)
    (cl-letf (((symbol-function 'loki-assistant-notify)
               (lambda (&rest args)
                 (setq arguments args))))
      (with-temp-buffer
        (loki-assistant-agent-shell--notify (current-buffer) "Agent" "Finished")))
    (should (equal (nth 1 arguments) "Agent"))
    (should (equal (plist-get (cddr arguments) :body) "Finished"))
    (should (equal (plist-get (cddr arguments) :module-id) "emacs"))
    (should (functionp (plist-get (cddr arguments) :callback)))))

(ert-deftest loki-assistant-agent-shell-status-collects-session-state-and-clears-closed-buffers ()
  (let (buffers published first-id callback (status 'ready) (initialized nil)
        (live t) (syncs 0) (subscriptions 0))
    (cl-letf (((symbol-function 'agent-shell-buffers) (lambda () buffers))
              ((symbol-function 'agent-shell-subscribe-to)
               (lambda (&rest args)
                 (setq callback (plist-get args :on-event))
                 (cl-incf subscriptions)))
              ((symbol-function 'get-buffer-process) (lambda (&optional _) 'shell))
              ((symbol-function 'process-live-p) (lambda (_) live))
              ((symbol-function 'agent-shell-initialized-p) (lambda (&rest _) initialized))
              ((symbol-function 'agent-shell-status) (lambda (&rest _) status))
              ((symbol-function 'loki-assistant-status-trigger-sync) (lambda () (cl-incf syncs))))
      (let ((collect (lambda ()
                       (loki-assistant-agent-shell--collect-status
                        (lambda (module key value)
                          (should (equal (list module key) '("emacs" "agent_shell")))
                          (setq published value))))))
        (with-temp-buffer
          (setq-local agent-shell--state '((:client . ((:process . acp)))))
          (setq buffers (list (current-buffer)))
          (funcall collect)
          (setq first-id (alist-get 'id (aref published 0)))
          (should (equal first-id (buffer-name)))
          (should (equal (alist-get 'phase (aref published 0)) "starting"))
          (setq initialized t status 'busy)
          (funcall callback '((:event . input-submitted) (:data . ((:prompt . "私有输入")))))
          (funcall collect)
          (should (equal (aref published 0) `((id . ,first-id) (phase . "running"))))
          (let ((agent-shell--state
                 (cons (cons :session (list (cons :title (concat "  会话主题  " "\n" "后续正文"))))
                       agent-shell--state)))
            (funcall callback '((:event . session-title-changed)))
            (funcall collect)
            (should (equal (alist-get 'title (aref published 0)) "会话主题")))
          (setq status 'blocked)
          (funcall callback '((:event . elicitation-request)))
          (funcall collect)
          (should (equal (alist-get 'phase (aref published 0)) "waiting_input"))
          (setq status 'ready)
          (funcall callback '((:event . turn-complete) (:data . ((:stop-reason . "end_turn")))))
          (funcall collect)
          (should (equal (aref published 0)
                         `((id . ,first-id) (phase . "completed") (stop_reason . "end_turn"))))
          (setq live nil)
          (funcall collect)
          (should (equal (aref published 0) `((id . ,first-id) (phase . "disconnected"))))
          (funcall callback '((:event . clean-up))))
        (setq buffers nil)
        (funcall collect)
        (should (equal published []))
        (should (= syncs 5))
        (should (= subscriptions 1))))))

(ert-deftest loki-assistant-agent-shell-stream-publishes-history-updates-and-excludes-draft ()
  (require 'loki-assistant-agent-shell-stream)
  (with-temp-buffer
    (rename-buffer "测试会话 / \"双引号\"" t)
    (let* ((buffer (current-buffer))
           (name (buffer-name))
           (state '((:qualified-id . "1-msg-agent_message_chunk")))
           (inhibit-read-only t)
           (end (make-marker)))
      (insert (propertize "已提交\n" 'read-only t))
      (insert (propertize "回答" 'agent-shell-ui-state state 'agent-shell-ui-section 'body))
      (set-marker end (point))
      (insert "未提交草稿")
      (cl-letf (((symbol-function 'agent-shell-buffers) (lambda () (list buffer)))
                ((symbol-function 'agent-shell--live-prompt-start) (lambda () end)))
        (let* ((first (loki-assistant-agent-shell-stream-read name nil))
               (snapshot (json-parse-string first :object-type 'alist :array-type 'list))
               (revision (alist-get 'revision snapshot))
               (blocks (alist-get 'blocks snapshot)))
          (should (equal (alist-get 'kind snapshot) "snapshot"))
          (should (equal (mapcar (lambda (block) (alist-get 'text block)) blocks)
                         '("已提交" "回答")))
          (should (equal (loki-assistant-agent-shell-stream-read name revision) "null"))
          (goto-char end)
          (insert (propertize "更新" 'agent-shell-ui-state state 'agent-shell-ui-section 'body))
          (set-marker end (point))
          (let ((update (json-parse-string (loki-assistant-agent-shell-stream-read name revision)
                                           :object-type 'alist :array-type 'list)))
            (should (equal (alist-get 'kind update) "update"))
            (should (equal (alist-get 'text (car (alist-get 'blocks update))) "回答更新"))))))))

(ert-deftest loki-assistant-agent-shell-clear-buffer-keeps-prompt-and-publishes-empty-snapshot ()
  (require 'loki-assistant-agent-shell-stream)
  (with-temp-buffer
    (let* ((target (current-buffer))
           (name (buffer-name))
           (process (make-pipe-process :name "loki-clear-buffer-test" :buffer target :noquery t))
           (fragment '((:qualified-id . "agent_message_chunk")))
           (draft "首行提示\n末行提示> 未发送草稿")
           prompt-start)
      (unwind-protect
          (progn
            (insert (propertize "历史回复\n" 'agent-shell-ui-state fragment 'agent-shell-ui-section 'body))
            (setq prompt-start (point-marker))
            (insert "首行提示\n末行提示> ")
            (set-marker (process-mark process) (point))
            (insert "未发送草稿")
            (cl-letf (((symbol-function 'agent-shell-buffers) (lambda () (list target)))
                      ((symbol-function 'agent-shell--live-prompt-start) (lambda () prompt-start))
                      ((symbol-function 'shell-maker--process) (lambda () process))
                      ((symbol-function 'agent-shell-clear-buffer) #'shell-maker-clear-buffer))
              (let* ((before (json-parse-string (loki-assistant-agent-shell-stream-read name nil)
                                                :object-type 'alist :array-type 'list))
                     (revision (alist-get 'revision before)))
                (should (alist-get 'blocks before))
                (should (equal (loki-assistant-agent-shell-clear-buffer name) "{\"kind\":\"accepted\"}"))
                (should (equal (buffer-string) draft))
                (should (equal (buffer-substring-no-properties (process-mark process) (point-max)) "未发送草稿"))
                (let ((after (json-parse-string (loki-assistant-agent-shell-stream-read name revision)
                                                :object-type 'alist :array-type 'list)))
                  (should (equal (alist-get 'kind after) "snapshot"))
                  (should-not (alist-get 'blocks after))))))
        (delete-process process)))))

(ert-deftest loki-assistant-agent-shell-restart-session-uses-native-restart ()
  (require 'loki-assistant-agent-shell-stream)
  (with-temp-buffer
    (let ((target (current-buffer))
          (status 'busy)
          called)
      (cl-letf (((symbol-function 'agent-shell-buffers) (lambda () (list target)))
                ((symbol-function 'agent-shell-status) (lambda () status))
                ((symbol-function 'agent-shell-session-id) (lambda () "provider-id"))
                ((symbol-function 'agent-shell--prompt-input-start) #'ignore)
                ((symbol-function 'agent-shell-viewport--buffer) #'ignore)
                ((symbol-function 'agent-shell-restart)
                 (lambda (&rest arguments)
                   (should (eq (current-buffer) target))
                   (setq called arguments))))
        (setq-local agent-shell--state '((:supports-session-load . t)))
        (should (equal (loki-assistant-agent-shell-restart-session (buffer-name)) "{\"kind\":\"busy\"}"))
        (should-not called)
        (setq status 'ready)
        (should (equal (loki-assistant-agent-shell-restart-session (buffer-name)) "{\"kind\":\"accepted\"}"))
        (should (equal called '(:session-id "provider-id")))))))

(ert-deftest loki-assistant-agent-shell-restart-stream-follows-same-name ()
  (require 'loki-assistant-agent-shell-stream)
  (let* ((original (generate-new-buffer " *loki-agent-shell-restart-test*"))
         (name (buffer-name original))
         (fragment '((:qualified-id . "agent_message_chunk")))
         accepted frames client replacement
         (server (make-network-process
                  :name "loki-agent-shell-restart-test"
                  :server t :host "127.0.0.1" :service t :family 'ipv4 :noquery t
                  :log (lambda (_server process _message)
                         (setq accepted process)
                         (set-process-filter
                          process (lambda (_process output) (setq frames (concat frames output))))))))
    (unwind-protect
        (cl-letf (((symbol-function 'agent-shell--current-shell) (lambda () original))
                  ((symbol-function 'agent-shell-buffers) (lambda () (list (or replacement original))))
                  ((symbol-function 'agent-shell--live-prompt-start) #'point-max))
          (with-current-buffer original
            (insert (propertize "重启前" 'agent-shell-ui-state fragment 'agent-shell-ui-section 'body))
            (should (loki-assistant-agent-shell-stream-subscribe name (process-contact server :service) "token"))
            (setq client (car loki-assistant-agent-shell-stream--clients)))
          (let ((deadline (+ (float-time) 2)))
            (while (and (< (float-time) deadline) (not (string-match-p "重启前" (or frames ""))))
              (accept-process-output nil 0.05)))
          (should (string-match-p "重启前" (or frames "")))
          (let ((revision (process-get client :revision)))
            (setq frames "")
            (loki-assistant-agent-shell-stream--follow-restart
             (lambda ()
               (kill-buffer original)
               (setq replacement (get-buffer-create name))
               (with-current-buffer replacement
                 (insert (propertize "重启后" 'agent-shell-ui-state fragment 'agent-shell-ui-section 'body)))))
            (should-not (process-get client :revision))
            (process-send-string accepted "\n")
            (let ((deadline (+ (float-time) 2)))
              (while (and (< (float-time) deadline) (not (string-match-p "重启后" frames)))
                (accept-process-output nil 0.05)))
            (let ((event (json-parse-string frames :object-type 'alist)))
              (should (equal (alist-get 'kind event) "snapshot"))
              (should (not (eql (alist-get 'revision event) revision)))
              (should (string-match-p "重启后" frames))))
          (should (process-live-p client))
          (should (eq (process-get client :shell-buffer) replacement)))
      (when (process-live-p client) (delete-process client))
      (when (process-live-p accepted) (delete-process accepted))
      (when (process-live-p server) (delete-process server))
      (when (buffer-live-p original) (kill-buffer original))
      (when (buffer-live-p replacement) (kill-buffer replacement)))))

(ert-deftest loki-assistant-agent-shell-stream-publishes-submitted-image-attachments ()
  (require 'loki-assistant-agent-shell-stream)
  (let* ((image (make-temp-file "截图 (测试) " nil ".png"))
         (png (base64-decode-string
               "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aS1sAAAAASUVORK5CYII="))
         (encoded (url-hexify-string image)))
    (unwind-protect
        (progn
          (let ((coding-system-for-write 'no-conversion))
            (write-region png nil image nil 'silent))
          (dolist (variant '(plain structured steered))
            (with-temp-buffer
              (let* ((buffer (current-buffer))
                     (inhibit-read-only t)
                     (context (propertize (format "@\"%s\"" image)
                                          'display (list 'image :file image)
                                          'agent-shell-context-image t))
                     (history (concat "请查看" context))
                     end)
                (pcase variant
                  ('structured
                   (insert (propertize history
                                       'agent-shell-ui-section 'body
                                       'agent-shell-ui-state '((:qualified-id . "test-user_message_chunk")))))
                  ('steered
                   (insert (propertize
                            (concat (propertize "QA> " 'field 'output)
                                    (propertize "[steer] " 'agent-shell-steer-prefix t)
                                    history)
                            'read-only t
                            'agent-shell-ui-state '((:qualified-id . "test-steered-user_message_chunk")))))
                  ('plain (insert (propertize history 'read-only t))))
                (setq end (point))
                (insert (propertize "尚未提交" 'read-only t))
                (cl-letf (((symbol-function 'agent-shell-buffers) (lambda () (list buffer)))
                          ((symbol-function 'agent-shell--live-prompt-start) (lambda () end)))
                  (let* ((snapshot (json-parse-string (loki-assistant-agent-shell-stream-read (buffer-name) nil)
                                                      :object-type 'alist :array-type 'list))
                         (row (car (alist-get 'blocks snapshot)))
                         (attachment (json-parse-string
                                      (loki-assistant-agent-shell-read-image (buffer-name) encoded)
                                      :object-type 'alist)))
                    (should (equal (alist-get 'kind row) "user"))
                    (should (equal (alist-get 'text row) (format "请查看\n\n![图片](%s)" encoded)))
                    (should (equal (alist-get 'mime attachment) "image/png"))
                    (should (equal (base64-decode-string (alist-get 'data attachment)) png))))))))
      (delete-file image))))

(ert-deftest loki-assistant-agent-shell-stream-resume-resets-after-revision-range-changes ()
  (require 'loki-assistant-agent-shell-stream)
  (with-temp-buffer
    (let ((buffer (current-buffer))
          (fragment '((:qualified-id . "1-agent_message_chunk"))))
      (cl-letf (((symbol-function 'agent-shell-buffers) (lambda () (list buffer)))
                ((symbol-function 'agent-shell--live-prompt-start) #'point-max))
        (let* ((session (buffer-name))
               (first (json-parse-string (loki-assistant-agent-shell-stream-read session nil)
                                         :object-type 'alist))
               (revision (alist-get 'revision first)))
          (insert (propertize "新内容" 'agent-shell-ui-state fragment 'agent-shell-ui-section 'body))
          (let* ((increment (json-parse-string (loki-assistant-agent-shell-stream-read session revision)
                                               :object-type 'alist))
                 (latest (alist-get 'revision increment)))
            (should (equal (alist-get 'kind increment) "update"))
            (should (= latest (1+ revision)))
            (should (equal (loki-assistant-agent-shell-stream-read session latest) "null"))
            (setq loki-assistant-agent-shell-stream--state nil)
            (let ((replacement (json-parse-string (loki-assistant-agent-shell-stream-read session latest)
                                                   :object-type 'alist)))
              (should (equal (alist-get 'kind replacement) "snapshot"))
              (should-not (= latest (alist-get 'revision replacement)))
              (should (< (alist-get 'revision replacement) (ash 1 53))))))))))

(ert-deftest loki-assistant-agent-shell-stream-preserves-folds-and-fragment-source ()
  (require 'loki-assistant-agent-shell-stream)
  (with-temp-buffer
    (let* ((buffer (current-buffer))
           (group '((:qualified-id . "activity-1") (:kind . group) (:collapsed . t)))
           (tool '((:qualified-id . "exec-1") (:group-id . "activity-1") (:collapsed . t)))
           (inhibit-read-only t))
      (insert (propertize "活动" 'agent-shell-ui-state group 'agent-shell-ui-section 'label-left))
      (insert "\n")
      (insert (propertize "› " 'agent-shell-ui-state tool 'agent-shell-ui-section 'indicator))
      (insert (propertize "工具" 'agent-shell-ui-state tool 'agent-shell-ui-section 'label-left))
      (insert (propertize "显示文本" 'agent-shell-ui-state tool 'agent-shell-ui-section 'body
                          'agent-shell-markdown-source "```rust\n  let value = 1;\n```"))
      (cl-letf (((symbol-function 'agent-shell-buffers) (lambda () (list buffer)))
                ((symbol-function 'agent-shell--live-prompt-start) #'point-max))
        (let* ((snapshot (json-parse-string
                          (loki-assistant-agent-shell-stream-read (buffer-name) nil)
                          :object-type 'alist :array-type 'list))
               (blocks (alist-get 'blocks snapshot))
               (group-id (alist-get 'id (car blocks))))
          (should (equal (alist-get 'kind (car blocks)) "group"))
          (should (eq (alist-get 'collapsed (car blocks)) t))
          (should (equal (alist-get 'parent_id (cadr blocks)) group-id))
          (should (equal (alist-get 'text (cadr blocks)) "```rust\n  let value = 1;\n```"))
          (put-text-property (point-min) (+ (point-min) 2) 'agent-shell-ui-state
                             '((:qualified-id . "activity-1") (:kind . group) (:collapsed . nil)))
          (let* ((update (json-parse-string
                          (loki-assistant-agent-shell-stream-read (buffer-name) (alist-get 'revision snapshot))
                          :object-type 'alist :array-type 'list :false-object :false))
                 (changed (alist-get 'blocks update)))
            (should (equal (alist-get 'kind update) "update"))
            (should (= (length changed) 1))
            (should (equal (alist-get 'id (car changed)) group-id))
            (should (eq (alist-get 'collapsed (car changed)) :false))))))))

(ert-deftest loki-assistant-agent-shell-remote-message-steers-running-turn ()
  (require 'loki-assistant-agent-shell-stream)
  (with-temp-buffer
    (let ((buffer (current-buffer))
          (process (make-pipe-process :name "loki-agent-steer-test" :noquery t))
          (text "  手机消息\n第二行"))
      (unwind-protect
          (progn
            (setq major-mode 'agent-shell-mode)
            (setq-local agent-shell--state (agent-shell--make-state :buffer buffer))
            (map-put! agent-shell--state :client `((:process . ,process)))
            (insert "桌面草稿")
            (cl-letf (((symbol-function 'agent-shell-buffers) (lambda () (list buffer)))
                      ((symbol-function 'agent-shell-initialized-p) (lambda () t))
                      ((symbol-function 'agent-shell-steering-supported-p) (lambda () t)))
              (dolist (status '(busy blocked))
                (let (steered)
                  (cl-letf (((symbol-function 'agent-shell-status) (lambda () status))
                            ((symbol-function 'agent-shell-experimental--send-steering)
                             (cl-function (lambda (&key state prompt)
                                            (should (eq state agent-shell--state))
                                            (setq steered prompt)))))
                    (should (equal (loki-assistant-agent-shell-send-message (buffer-name) text)
                                   "{\"kind\":\"accepted\"}"))
                    (should (equal steered text))
                    (should (equal (buffer-string) "桌面草稿")))))
              (cl-letf (((symbol-function 'agent-shell-status) (lambda () 'busy))
                        ((symbol-function 'agent-shell-steering-supported-p) #'ignore)
                        ((symbol-function 'agent-shell--prompt-queue-echo) #'ignore))
                (should (equal (loki-assistant-agent-shell-send-message (buffer-name) text)
                               "{\"kind\":\"accepted\"}"))
                (should (equal (map-elt agent-shell--state :pending-prompts) (list text)))
                (should (equal (buffer-string) "桌面草稿")))))
        (delete-process process)))))

(ert-deftest loki-assistant-agent-shell-remote-message-preserves-idle-draft ()
  (require 'loki-assistant-agent-shell-stream)
  (with-temp-buffer
    (let ((buffer (current-buffer))
          (process (make-pipe-process :name "loki-agent-draft-test" :noquery t))
          (draft (propertize "  桌面草稿 \n" 'face 'bold))
          (text "手机消息")
          submitted)
      (unwind-protect
          (progn
            (setq-local agent-shell--state `((:client (:process . ,process))))
            (insert "提示符\n")
            (let ((start (point)))
              (insert draft)
              (goto-char (+ start 2))
              (cl-letf (((symbol-function 'agent-shell-buffers) (lambda () (list buffer)))
                        ((symbol-function 'agent-shell-initialized-p) (lambda () t))
                        ((symbol-function 'agent-shell-status) (lambda () 'ready))
                        ((symbol-function 'agent-shell--prompt-input-start) (lambda () start))
                        ((symbol-function 'agent-shell-insert)
                         (cl-function
                          (lambda (&key text submit no-focus shell-buffer)
                            (should (= (point-max) start))
                            (should (and submit no-focus (eq shell-buffer buffer)))
                            (setq submitted text)
                            (goto-char (point-max))
                            (insert "手机消息\n新提示符\n")
                            (setq start (point))))))
                (should (equal (loki-assistant-agent-shell-send-message (buffer-name) text)
                               "{\"kind\":\"accepted\"}"))
                (should (equal submitted text))
                (should (equal-including-properties (buffer-substring start (point-max)) draft))
                (should (= (point) (+ start 2))))))
        (delete-process process)))))

(ert-deftest loki-assistant-agent-shell-remote-message-queues-until-init-finishes ()
  (require 'loki-assistant-agent-shell-stream)
  (with-temp-buffer
    (let ((buffer (current-buffer))
          (process (make-pipe-process :name "loki-agent-init-test" :noquery t))
          submitted)
      (unwind-protect
          (progn
            (setq major-mode 'agent-shell-mode)
            (setq-local agent-shell--state (agent-shell--make-state :buffer buffer))
            (map-put! agent-shell--state :client `((:process . ,process)))
            (cl-letf (((symbol-function 'agent-shell-buffers) (lambda () (list buffer)))
                      ((symbol-function 'agent-shell-status) (lambda () 'ready))
                      ((symbol-function 'agent-shell--prompt-input-start) #'point-max)
                      ((symbol-function 'agent-shell--prompt-queue-echo) #'ignore)
                      ((symbol-function 'agent-shell--insert-to-shell-buffer)
                       (cl-function (lambda (&key text submit no-focus)
                                      (should (and submit no-focus))
                                      (setq submitted text)))))
              (let ((agent-shell-prompt-queue-merge t))
                (dolist (text '("第一条" "第二条"))
                  (should (equal (loki-assistant-agent-shell-send-message (buffer-name) text)
                                 "{\"kind\":\"accepted\"}")))
                (should-not submitted)
                (let ((subscriptions (map-elt agent-shell--state :event-subscriptions))
                      scheduled)
                  (should (= (length subscriptions) 1))
                  (should (eq (map-elt (car subscriptions) :event) 'init-finished))
                  (map-put! agent-shell--state :init-finished t)
                  (cl-letf (((symbol-function 'run-at-time)
                             (lambda (_time _repeat function &rest args)
                               (setq scheduled (cons function args)))))
                    (funcall (map-elt (car subscriptions) :on-event) nil))
                  (should-not (map-elt agent-shell--state :event-subscriptions))
                  (should-not submitted)
                  (apply (car scheduled) (cdr scheduled))
                  (should (equal submitted "第一条\n\n第二条"))
                  (should-not (map-elt agent-shell--state :pending-prompts))))))
        (delete-process process)))))

